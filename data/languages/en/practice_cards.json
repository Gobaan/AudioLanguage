      "stage": "guided_scene_production",
      "correct_function_id": "respond_to_greeting",
      "target_id": "en-target-respond-hi",
      "prompt": "Watch the scene once. Then replay the cue and say your part when prompted.",
      "expected_response": "Hi!",
      "ai_scene_contract": {
        "language_being_practiced": "English",
        "support_language": "English",
        "physical_scene": "A friendly person sees the learner at a casual community event.",
        "learner_role": "person being greeted",
        "partner_role": "friendly acquaintance",
        "current_turn": "partner_speaks_first",
        "target_function": {
          "id": "respond_to_greeting",
          "definition": "The learner responds appropriately when someone says hi or hello."
        },
        "learner_intention": "Respond to a friendly 'Hi' greeting.",
        "required_slots": {
          "speech_act": "greeting_response"
        },
        "optional_slots": {
          "return_greeting": true,
          "ask_wellbeing": true
        },
        "example_valid_responses": [
          "Hi.",
          "Hi?",
          "Hello.",
          "Hello?",
          "Hey.",
          "Hi, how are you?",
          "Hello, nice to see you."
        ],
        "acceptance_notes": [
          "Accept greeting words even if transcribed with a question mark.",
          "Accept 'Hello?' as a direct greeting response to 'Hi'.",
          "For this first beginner scene, do not require an added wellbeing question."
        ],
        "wrong_intents": [
          {
            "id": "ignore_greeting",
            "definition": "The learner says nothing or gives no greeting-like response."
          },
          {
            "id": "ask_unrelated_question",
            "definition": "The learner asks something unrelated to greeting the person."
          },
          {
            "id": "end_conversation",
            "definition": "The learner immediately says goodbye or leaves."
          }
        ]
      },
      "support": {},
      "success_signal": "learner hears the full scene, then successfully supplies the missing greeting response"
    },
